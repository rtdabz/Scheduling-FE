# Production build settings for wicars-ui.
# Vite reads this file automatically on `npm run build` and bakes the values into
# the bundle in dist/. Everything here ends up public in the browser, so never
# put secrets in this file.

# Base URL of the Laravel API, including the /api prefix.
# - Frontend and backend on separate domains: use the full backend URL, e.g.
#     VITE_API_BASE_URL=https://api.example.com/api
#   The backend's FRONTEND_URL (CORS) must then be set to the frontend's origin.
# - Same domain, with the web server sending /api to Laravel: leave it as /api.
VITE_API_BASE_URL=https://api.tccsched.site/api
